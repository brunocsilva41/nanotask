#include <windows.h>

// Gerado pelo CMake a partir de version.rc.in — não editar direto.
// Versão: arquivo VERSION (fonte única), sobrescrita pela tag no CI.

VS_VERSION_INFO VERSIONINFO
  FILEVERSION     @APP_VERSION_MAJOR@,@APP_VERSION_MINOR@,@APP_VERSION_PATCH@,@APP_VERSION_BUILD@
  PRODUCTVERSION  @APP_VERSION_MAJOR@,@APP_VERSION_MINOR@,@APP_VERSION_PATCH@,@APP_VERSION_BUILD@
  FILEFLAGSMASK   VS_FFI_FILEFLAGSMASK
  FILEFLAGS       0x0L
  FILEOS          VOS_NT_WINDOWS32
  FILETYPE        VFT_APP
  FILESUBTYPE     VFT2_UNKNOWN
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040904B0"
    BEGIN
      VALUE "CompanyName",      "NanoTask Labs"
      VALUE "FileDescription",  "NanoTask - system tray monitor fantasma"
      VALUE "FileVersion",      "@APP_VERSION_STR@"
      VALUE "InternalName",     "NanoTask"
      VALUE "OriginalFilename", "NanoTask.exe"
      VALUE "ProductName",      "NanoTask"
      VALUE "ProductVersion",   "@APP_VERSION_STR@"
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x409, 1200
  END
END

// Ícone principal do EXE (Explorer + barra de tarefas)
IDI_ICON1 ICON DISCARDABLE "@CMAKE_SOURCE_DIR_FOR_RC@/assets/app.ico"
