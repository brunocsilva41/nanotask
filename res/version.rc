#include <windows.h>

// Versão vem do CMake via /DAPP_VERSION_* (ver CMakeLists.txt).
// Fallback para build direto fora do CMake.
#ifndef APP_VERSION_MAJOR
#define APP_VERSION_MAJOR 1
#define APP_VERSION_MINOR 1
#define APP_VERSION_PATCH 0
#define APP_VERSION_BUILD 0
#endif

#define APP_VERSION_STR "1.1.0"

// rc.exe não expande macros em FILEVERSION/PRODUCTVERSION: usa literais
// pré-processados via stringize numérico.
#define RC_NUM2(a) a
#define RC_FILEVER APP_VERSION_MAJOR,APP_VERSION_MINOR,APP_VERSION_PATCH,APP_VERSION_BUILD

VS_VERSION_INFO VERSIONINFO
  FILEVERSION     RC_FILEVER
  PRODUCTVERSION  RC_FILEVER
  FILEFLAGSMASK   VS_FFI_FILEFLAGSMASK
#ifdef _DEBUG
  FILEFLAGS       VS_FF_DEBUG
#else
  FILEFLAGS       0x0L
#endif
  FILEOS          VOS_NT_WINDOWS32
  FILETYPE        VFT_APP
  FILESUBTYPE     VFT2_UNKNOWN
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040904B0"
    BEGIN
      VALUE "CompanyName",      "NanoTask Labs"
      VALUE "FileDescription",  "NanoTask - system tray monitor fantasma"
      VALUE "FileVersion",      APP_VERSION_STR
      VALUE "InternalName",     "NanoTask"
      VALUE "OriginalFilename", "NanoTask.exe"
      VALUE "ProductName",      "NanoTask"
      VALUE "ProductVersion",   APP_VERSION_STR
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x409, 1200
  END
END

// Ícone principal do EXE (Explorer + barra de tarefas)
IDI_ICON1 ICON DISCARDABLE "app.ico"
