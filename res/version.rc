#include <windows.h>

// Gerado pelo CI: NanoTaskinkler escreve a versão aqui via /DAPP_VERSION.
// Valores de fallback para build local.
#ifndef APP_VERSION_MAJOR
#define APP_VERSION_MAJOR 1
#define APP_VERSION_MINOR 0
#define APP_VERSION_PATCH 0
#define APP_VERSION_BUILD 0
#endif

#define APP_VERSION_STR "1.0.0"

VS_VERSION_INFO VERSIONINFO
  FILEVERSION     APP_VERSION_MAJOR,APP_VERSION_MINOR,APP_VERSION_PATCH,APP_VERSION_BUILD
  PRODUCTVERSION  APP_VERSION_MAJOR,APP_VERSION_MINOR,APP_VERSION_PATCH,APP_VERSION_BUILD
  FILEFLAGSMASK   VS_FFI_FILEFLAGSMASK
#ifdef _DEBUG
  FILEFLAGS       VS_FF_DEBUG
#else
  FILEFLAGS       0x0L
#endif
  FILEOS          VOS_NT_WINDOWS32
  FILETYPE        VFT_APP
  FILESUBTYPE     VFT2_UNKNOWN
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040904B0"
    BEGIN
      VALUE "CompanyName",      "NanoTask Labs"
      VALUE "FileDescription",  "NanoTask — system tray monitor fantasma"
      VALUE "FileVersion",      APP_VERSION_STR
      VALUE "InternalName",     "NanoTask"
      VALUE "OriginalFilename", "NanoTask.exe"
      VALUE "ProductName",      "NanoTask"
      VALUE "ProductVersion",   APP_VERSION_STR
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x409, 1200
  END
END

// Ícone principal do EXE (Exibir em Explorer + barra de tarefas)
IDI_ICON1 ICON "../assets/app.ico"
